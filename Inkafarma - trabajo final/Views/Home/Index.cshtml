@{
    ViewData["Title"] = "Dashboard - Inkafarma";
}

    <!-- Contenido principal -->
    <div class="main-content">


            <!-- Cards de estadísticas -->
            <div class="stats-cards">
                <div class="stat-card">
                    <div class="stat-icon green">💰</div>
                    <div class="stat-info">
                        <div class="stat-label">Ventas del día</div>
                        <div class="stat-value">S/. 130, 370</div>
                    </div>
                </div>
                
                <div class="stat-card">
                    <div class="stat-icon blue">📱</div>
                    <div class="stat-info">
                        <div class="stat-label">Pedidos digitales</div>
                        <div class="stat-value">20</div>
                    </div>
                </div>
                
                <div class="stat-card">
                    <div class="stat-icon orange">📦</div>
                    <div class="stat-info">
                        <div class="stat-label">Stock total</div>
                        <div class="stat-value">23,300</div>
                    </div>
                </div>
            </div>

            <!-- Gráficos y contenido -->
            <div class="charts-section">
                <!-- Gráfico de ventas -->
                <div class="chart-container">
                    <h3 class="chart-title">VENTAS</h3>
                    <div class="chart-area">
                        <!-- Simulación de gráfico de área -->
                        <svg class="sales-chart" viewBox="0 0 600 300">
                            <!-- Líneas de fondo -->
                            <defs>
                                <linearGradient id="areaGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                                    <stop offset="0%" style="stop-color:#4fc3f7;stop-opacity:0.8" />
                                    <stop offset="100%" style="stop-color:#4fc3f7;stop-opacity:0.1" />
                                </linearGradient>
                            </defs>
                            
                            <!-- Grid lines -->
                            <g stroke="#e0e0e0" stroke-width="1">
                                <line x1="50" y1="50" x2="550" y2="50"></line>
                                <line x1="50" y1="100" x2="550" y2="100"></line>
                                <line x1="50" y1="150" x2="550" y2="150"></line>
                                <line x1="50" y1="200" x2="550" y2="200"></line>
                                <line x1="50" y1="250" x2="550" y2="250"></line>
                            </g>
                            
                            <!-- Área del gráfico -->
                            <path d="M 50 220 L 100 200 L 150 180 L 200 160 L 250 120 L 300 80 L 350 140 L 400 100 L 450 180 L 500 200 L 550 190 L 550 250 L 50 250 Z" 
                                  fill="url(#areaGradient)" stroke="#29b6f6" stroke-width="2"/>
                        </svg>
                    </div>
                </div>

                <!-- Panel de métodos de pago -->
                <div class="payment-methods">
                    <h3 class="section-title">VENTAS POR MÉTODO DE PAGO</h3>
                    <p class="section-description">
                        Las ventas por método de pago nos permiten saber 
                        cuánto cobraron en efectivo, visa, diners, y cualquier otro.
                    </p>
                    
                    <!-- Gráfico de barras simple -->
                    <div class="bar-chart">
                        <div class="bar-item">
                            <div class="bar-label">Efectivo</div>
                            <div class="bar-container">
                                <div class="bar bar-high"></div>
                            </div>
                        </div>
                        <div class="bar-item">
                            <div class="bar-label">Visa</div>
                            <div class="bar-container">
                                <div class="bar bar-medium"></div>
                            </div>
                        </div>
                        <div class="bar-item">
                            <div class="bar-label">Cheque</div>
                            <div class="bar-container">
                                <div class="bar bar-low"></div>
                            </div>
                        </div>
                        <div class="bar-item">
                            <div class="bar-label">Otros</div>
                            <div class="bar-container">
                                <div class="bar bar-minimal"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Detalles de montos -->
                    <div class="payment-details">
                        <div class="detail-item">
                            <span class="detail-label">Efectivo</span>
                            <span class="detail-amount">S/ 260.00</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Visa</span>
                            <span class="detail-amount">S/ 0.00</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Cheque</span>
                            <span class="detail-amount">S/ 0.00</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Otros</span>
                            <span class="detail-amount">S/ 0.00</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>


    </div>



