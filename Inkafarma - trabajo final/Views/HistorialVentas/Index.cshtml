@{
    ViewData["Title"] = "Historial de Ventas - Inkafarma";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/historialVentas.css" />
</head>
<body>
    <!-- Barra lateral -->
    <div class="sidebar">
        <div class="sidebar-header">
            <div class="logo">
                <img src="~/images/logo.png" alt="Inkafarma" class="logo-image" 
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                <div class="logo-fallback">
                    <span class="logo-icon">+</span>
                    <span class="logo-text">Inkafarma</span>
                </div>
            </div>
            <div class="subtitle">INKAVENTAS</div>
        </div>
        
        <nav class="sidebar-nav">
            <a href="/Dashboard" class="nav-item">
                <span class="nav-icon">🏠</span>
                <span class="nav-text">Inicio</span>
            </a>
            <a href="#" class="nav-item active">
                <span class="nav-icon">🛒</span>
                <span class="nav-text">Ventas</span>
            </a>
            <a href="#" class="nav-item">
                <span class="nav-icon">📦</span>
                <span class="nav-text">Pedidos digitales</span>
            </a>
            <a href="#" class="nav-item">
                <span class="nav-icon">📋</span>
                <span class="nav-text">Inventario</span>
            </a>
        </nav>
    </div>

    <!-- Contenido principal -->
    <div class="main-content">
        <!-- Contenido de historial de ventas -->
        <div class="sales-content">
            <!-- Tabs de navegación -->
            <div class="tabs-container">
                <div class="tab" onclick="goToVentas()">Punto de ventas</div>
                <div class="tab active">Historial de Ventas</div>
            </div>

            <!-- Buscador -->
            <div class="search-container">
                <div class="search-box">
                    <input type="text" placeholder="Ingrese nombre de producto o laboratorio" class="search-input">
                    <button class="search-button">
                        <span class="search-icon">🔍</span>
                        Buscar
                    </button>
                </div>
            </div>

            <!-- Filtros -->
            <div class="filters-container">
                <div class="filter-group">
                    <label class="filter-label">Filtrar por fechas:</label>
                    <select class="filter-select">
                        <option value="">01/01/2025 - 01/31/2025</option>
                        <option value="">01/01/2025 - 01/15/2025</option>
                        <option value="">01/16/2025 - 01/31/2025</option>
                    </select>
                </div>
                
                <div class="results-info">
                    <span>Primera aparición para buscar ventas:</span>
                </div>

                <div class="table-controls">
                    <div class="show-entries">
                        <label>Todas las ventas</label>
                        <select class="entries-select">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>
                    <button class="download-btn">Descargar</button>
                </div>
            </div>

            <!-- Tabla de ventas -->
            <div class="table-container">
                <table class="sales-table">
                    <thead>
                        <tr>
                            <th class="checkbox-col">
                                <input type="checkbox" id="selectAll">
                            </th>
                            <th>Nro. de comprobante</th>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Vencimiento</th>
                            <th>Total</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
