                </table>
            </div>

            <!-- Paginación -->
            <div class="pagination-container">
                <div class="pagination-info">
                    Mostrando 1 a 13 de 13 entradas
                </div>
                <div class="pagination-controls">
                    <button class="page-btn" disabled>Anterior</button>
                    <button class="page-btn active">1</button>
                    <button class="page-btn" disabled>Siguiente</button>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <footer class="footer">
            <span>2025 &copy; INKAVENTAS</span>
        </footer>
    </div>

    <script>
        // Funcionalidad de navegación
        function goToVentas() {
            window.location.href = '/Dashboard/Ventas';
        }

        // Funcionalidad de checkboxes
        document.getElementById('selectAll').addEventListener('change', function() {
            const checkboxes = document.querySelectorAll('.row-checkbox');
            checkboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
            });
        });

        // Funcionalidad de tabs
        document.querySelectorAll('.tab').forEach(tab => {
            tab.addEventListener('click', function() {
                if (!this.classList.contains('active')) {
                    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
                    this.classList.add('active');
                }
            });
        });

        // Simulación de descarga
        document.querySelector('.download-btn').addEventListener('click', function() {
            alert('Descarga iniciada...');
        });
    </script>
</body>
</html>