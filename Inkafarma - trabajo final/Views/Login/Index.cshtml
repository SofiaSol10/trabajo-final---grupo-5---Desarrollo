@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Enlace al archivo CSS externo -->
    <link rel="stylesheet" href="~/css/login.css" />
</head>
<body>
    <div class="login-container">
        <!-- Sección del Logo -->
        <div class="logo-section">
            <div class="logo">
                <!-- Reemplaza 'logo.png' por el nombre de tu archivo de logo -->
                <img src="~/img/logo.png" alt="Inkafarma Logo" class="logo-image" 
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                <!-- Texto de respaldo si no se carga la imagen -->
                <div class="logo-text">Inkafarma</div>
            </div>
            
            <!-- Elementos decorativos -->
            <div class="decorative-elements">
                <div class="decorative-row">
                    <div class="decorative-item arrow"></div>
                    <div class="decorative-item arrow"></div>
                    <div class="decorative-item arrow"></div>
                    <div class="decorative-item cross"></div>
                    <div class="decorative-item cross"></div>
                    <div class="decorative-item cross"></div>
                </div>
                <div class="decorative-row">
                    <div class="decorative-item arrow"></div>
                    <div class="decorative-item arrow"></div>
                    <div class="decorative-item arrow"></div>
                    <div class="decorative-item cross"></div>
                    <div class="decorative-item cross"></div>
                    <div class="decorative-item cross"></div>
                </div>
                <div class="decorative-row">
                    <div class="decorative-item arrow"></div>
                    <div class="decorative-item arrow"></div>
                    <div class="decorative-item arrow"></div>
                    <div class="decorative-item cross"></div>
                    <div class="decorative-item cross"></div>
                    <div class="decorative-item cross"></div>
                </div>
            </div>
        </div>

        <!-- Formulario de Login -->
        <div class="login-form">
            <form method="post">
                <h2 class="form-title">Iniciar sesión</h2>
                
                <div class="form-group">
                    <input name="Usuario" type="text" class="form-input" placeholder="Usuario" required />
                </div>
                
                <div class="form-group">
                    <div class="password-input-container">
                        <input name="Contraseña" type="password" class="form-input" placeholder="Contraseña" required />
                        <button type="button" class="password-toggle" onclick="togglePassword()">👁</button>
                    </div>
                </div>
                
                <button type="submit" class="login-button">Ingresar</button>
                
                <div class="register-link">
                    ¿Todavía no tienes una cuenta? 
                    <a href="#register">Regístrate</a>
                </div>
            </form>
        </div>
    </div>

    <script>
        function togglePassword() {
            const passwordInput = document.querySelector('input[name="Contraseña"]');
            const toggleButton = document.querySelector('.password-toggle');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
            } else {
                passwordInput.type = 'password';
                toggleButton.textContent = '👁';
            }
        }
    </script>
</body>
</html>